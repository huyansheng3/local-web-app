# ── Validate create args ─────────────────────────────────────

if [[ -z "$APP_NAME" || -z "$APP_URL" || -z "$START_CMD" ]]; then
  echo "Error: app name, --url, and --start are required (or use --preset)." >&2
  echo "Run with --help for usage." >&2
  exit 1
fi

# ── Paths ─────────────────────────────────────────────────────

BUNDLE_ID="app.local-web.$(echo -n "$APP_NAME" | md5 | head -c8)"
APP_DIR="$HOME/Applications/${APP_NAME}.app"
MACOS_DIR="$APP_DIR/Contents/MacOS"
RES_DIR="$APP_DIR/Contents/Resources"
SRC_DIR="$(mktemp -d)"
SWIFT_FILE="$SRC_DIR/App.swift"
BIN_NAME="app-$(echo -n "$APP_NAME" | md5 | head -c8)"
LOG_NAME="local-web-app-${BIN_NAME}.log"

echo "→ App:      $APP_DIR"
echo "→ Bundle:   $BUNDLE_ID"
echo "→ URL:      $APP_URL"
echo "→ Start:    $START_CMD"
echo "→ Timeout:  ${TIMEOUT}s"

# ── Icon handling (to temp dir, copied to app in package step) ──

ICON_NAME=""
ICON_ICNS=""  # final .icns path if conversion succeeded

# Download icon if URL
if [[ -n "$ICON_PATH" && "$ICON_PATH" == http* ]]; then
  ICON_WORK="$SRC_DIR/downloaded-icon.$(basename "$ICON_PATH" | sed 's/.*\.//')"
  echo "→ Icon:     downloading $ICON_PATH"
  if curl -sS -L --connect-timeout 10 --max-time 30 -o "$ICON_WORK" "$ICON_PATH" 2>/dev/null && [[ -f "$ICON_WORK" && -s "$ICON_WORK" ]]; then
    ICON_PATH="$ICON_WORK"
  else
    echo "  ⚠ Download failed, skipping icon"
    ICON_PATH=""
  fi
fi

if [[ -n "$ICON_PATH" && -f "$ICON_PATH" ]]; then
  if [[ "$ICON_PATH" == *.icns ]]; then
    ICON_ICNS="$ICON_PATH"
    ICON_NAME="AppIcon"
    echo "→ Icon:     ✅ icns ready"
  elif [[ "$ICON_PATH" == *.png ]]; then
    SIPS_ICONSET="$SRC_DIR/AppIcon.iconset"
    mkdir -p "$SIPS_ICONSET"
    sips -z 16 16     "$ICON_PATH" --out "$SIPS_ICONSET/icon_16x16.png"     >/dev/null 2>&1 || true
    sips -z 32 32     "$ICON_PATH" --out "$SIPS_ICONSET/icon_16x16@2x.png"  >/dev/null 2>&1 || true
    sips -z 32 32     "$ICON_PATH" --out "$SIPS_ICONSET/icon_32x32.png"     >/dev/null 2>&1 || true
    sips -z 64 64     "$ICON_PATH" --out "$SIPS_ICONSET/icon_32x32@2x.png"  >/dev/null 2>&1 || true
    sips -z 128 128   "$ICON_PATH" --out "$SIPS_ICONSET/icon_128x128.png"   >/dev/null 2>&1 || true
    sips -z 256 256   "$ICON_PATH" --out "$SIPS_ICONSET/icon_128x128@2x.png" >/dev/null 2>&1 || true
    sips -z 256 256   "$ICON_PATH" --out "$SIPS_ICONSET/icon_256x256.png"   >/dev/null 2>&1 || true
    sips -z 512 512   "$ICON_PATH" --out "$SIPS_ICONSET/icon_256x256@2x.png" >/dev/null 2>&1 || true
    sips -z 512 512   "$ICON_PATH" --out "$SIPS_ICONSET/icon_512x512.png"   >/dev/null 2>&1 || true
    sips -z 1024 1024 "$ICON_PATH" --out "$SIPS_ICONSET/icon_512x512@2x.png" >/dev/null 2>&1 || true
    iconutil -c icns "$SIPS_ICONSET" -o "$SRC_DIR/AppIcon.icns" >/dev/null 2>&1 || true
    rm -rf "$SIPS_ICONSET"
    if [[ -f "$SRC_DIR/AppIcon.icns" ]]; then
      ICON_ICNS="$SRC_DIR/AppIcon.icns"
      ICON_NAME="AppIcon"
      echo "→ Icon:     ✅ png → icns converted"
    else
      echo "  ⚠ Icon conversion failed"
    fi
  else
    echo "  ⚠ Unsupported icon format (use .png or .icns)"
  fi
elif [[ -n "$ICON_PATH" ]]; then
  echo "  ⚠ Icon file not found: $ICON_PATH"
fi

# ── Generate Swift source ─────────────────────────────────────

esc() { echo "$1" | sed "s/'/'\\\\''/g"; }
ESC_APP_NAME=$(esc "$APP_NAME")
ESC_APP_URL=$(esc "$APP_URL")
ESC_START_CMD=$(esc "$START_CMD")

cat > "$SWIFT_FILE" << SWIFT
import SwiftUI
@preconcurrency import WebKit

// Auto-generated by local-web-app/create v${VERSION}
// App: ${APP_NAME} | URL: ${APP_URL} | Start: ${START_CMD}

final class ServerManager: ObservableObject {
    @Published var isReady = false
    @Published var errorMessage: String?
    private var process: Process?
    private var startedByUs = false
    private var timeoutWork: DispatchWorkItem?

    init() {
        NotificationCenter.default.addObserver(
            forName: NSApplication.willTerminateNotification, object: nil, queue: .main
        ) { [weak self] _ in self?.shutdown() }
    }

    func launch() {
        probe { [weak self] up in
            guard let self else { return }
            if up { DispatchQueue.main.async { self.isReady = true } }
            else  { self.startServer() }
        }
    }

    func shutdown() {
        timeoutWork?.cancel()
        guard startedByUs, let process else { return }
        process.terminate()
        self.process = nil
    }

    private func startServer() {
        let p = Process()
        p.executableURL = URL(fileURLWithPath: "/bin/zsh")
        p.arguments = ["-l", "-c", "exec ${ESC_START_CMD}"]
        let logPath = URL(fileURLWithPath: NSTemporaryDirectory())
            .appendingPathComponent("${LOG_NAME}")
        FileManager.default.createFile(atPath: logPath.path, contents: nil)
        let logFH = try? FileHandle(forWritingTo: logPath)
        p.standardOutput = logFH
        p.standardError = logFH
        p.terminationHandler = { [weak self] proc in
            guard proc.terminationStatus != 0 else { return }
            DispatchQueue.main.async {
                self?.fail("Server exited (code \\(proc.terminationStatus)), log: \\(logPath.path)")
            }
        }
        guard (try? p.run()) != nil else {
            fail("Cannot start server process")
            return
        }
        process = p
        startedByUs = true
        poll()
        let timeout = ${TIMEOUT}
        let t = DispatchWorkItem { [weak self] in
            guard let self, !self.isReady else { return }
            self.fail("Server startup timed out (\\(timeout)s), log: \\(logPath.path)")
            self.shutdown()
        }
        timeoutWork = t
        DispatchQueue.main.asyncAfter(deadline: .now() + .init(timeout), execute: t)
    }

    private func poll() {
        guard !isReady else { return }
        URLSession.shared.dataTask(with: URL(string: "${ESC_APP_URL}")!) { _, resp, _ in
            DispatchQueue.main.async {
                if resp != nil {
                    self.timeoutWork?.cancel()
                    self.isReady = true
                } else {
                    DispatchQueue.main.asyncAfter(deadline: .now() + 0.5) { self.poll() }
                }
            }
        }.resume()
    }

    private func probe(done: @escaping (Bool) -> Void) {
        URLSession.shared.dataTask(with: URL(string: "${ESC_APP_URL}")!) { _, resp, _ in
            DispatchQueue.main.async { done(resp != nil) }
        }.resume()
    }

    private func fail(_ msg: String) {
        DispatchQueue.main.async { self.errorMessage = msg }
    }
}

final class WebViewCoordinator: NSObject, WKUIDelegate {
    func webView(
        _ webView: WKWebView,
        runOpenPanelWith parameters: WKOpenPanelParameters,
        initiatedByFrame frame: WKFrameInfo,
        completionHandler: @escaping ([URL]?) -> Void
    ) {
        let panel = NSOpenPanel()
        panel.canChooseFiles = true
        panel.canChooseDirectories = parameters.allowsDirectories
        panel.allowsMultipleSelection = parameters.allowsMultipleSelection
        panel.begin { response in
            completionHandler(response == .OK ? panel.urls : nil)
        }
    }
}

struct WebView: NSViewRepresentable {
    let url: URL
    func makeCoordinator() -> WebViewCoordinator { WebViewCoordinator() }
    func makeNSView(context: Context) -> WKWebView {
        let wv = WKWebView()
        wv.uiDelegate = context.coordinator
        wv.load(URLRequest(url: url))
        return wv
    }
    func updateNSView(_ wv: WKWebView, context: Context) {}
}

